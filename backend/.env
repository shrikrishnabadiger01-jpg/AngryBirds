# MiniMoth AI (Optional for live LLM response)
MINIMOTH_API_KEY=
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials (for Gmail Read-Only Integration)
# Create OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI must match: http://localhost:8000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# Application Settings
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./security_gate.db
