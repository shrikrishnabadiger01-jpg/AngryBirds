# AI Agent Security & IgnisGuard — Environment Variables

# MiniMoth phone OTP authentication
MINIMOTH_API_KEY=

# Google Gemini model (optional; separate from MiniMoth)
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials (for Gmail Read-Only Integration)
# Create OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI must match exactly: http://localhost:8000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# Application Settings
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./security_gate.db

# Production deployment access controls. Keep secrets outside source control.
APP_ENV=production
AUTH_ENABLED=true
AUTH_MODE=minimoth_otp
AUTH_DEFAULT_ROLE=operator
SECRET_KEY=replace-with-at-least-32-random-characters
# Only used with AUTH_MODE=password. Hash with: py -m app.auth --hash 'your-password'
# Each configured role must be admin, operator, or auditor.
APP_USERS_JSON={"admin":{"password_hash":"pbkdf2_sha256$310000$REPLACE_SALT$REPLACE_HASH","role":"admin"}}
